<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <!-- = THE WIRING file, when a component asks , answer WITH THIS -->
    <style name="Base.Theme.CanaryRock" parent="Theme.Material3.Dark.NoActionBar">



        <item name="colorPrimary">@color/accentColor</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/errorColor</item>
        <item name="android:colorBackground">@color/bg</item>

        <item name="android:windowBackground">@color/bg</item>

        <!-- Edge to edge screen HERE ?? -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Finally apply it all -->
        <item name="android:fontFamily">@font/app_font_regular</item>
        <item name="fontFamily">@font/app_font_regular</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.Header</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Label</item>

        <!-- Custom, from themes put here.. bruh -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>



    </style>

    <style name="Theme.CanaryRock" parent="Base.Theme.CanaryRock"/>

    <!--SPLASH SCREEN -->
    <style name="Theme.CanaryRock.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_rock</item>
        <item name="postSplashScreenTheme">@style/Theme.CanaryRock</item>
    </style>

    <!-- How to use now ?
    <TextView style = "@style/Text.Header" -->


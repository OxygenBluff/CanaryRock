<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/global_padding"
        >
        <!-- Username, Email, pass, redo pass ; 1/4 of screen down ?-->
        <TextView
            style="@style/Text.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_text"
            >
        </TextView>

        <!-- THE CARD WAIT NEEDS a vertical layout inside of it 0.0 it's frame.. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/global_padding"> <!-- -->
                <!-- 1-Username -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/username_label"/>

                <!-- The decoration THEN the actual textinput .. nested -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    >
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/usernameInput"
                        android:inputType="text"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/username_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2-Email -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/email_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    >
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/emailInput"
                        android:inputType="textEmailAddress"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/email_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3-Password one -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/password_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:endIconMinSize="@dimen/textfield_icon_size"
                    app:endIconTint="@color/black"

                    > <!-- Whoa it has that to peek ! -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/passwordInput"
                        android:inputType="textPassword"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/password_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- 4-Password again -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/retype_password_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:endIconMinSize="@dimen/textfield_icon_size"
                    app:endIconTint="@color/black"
                    >
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/retypePasswordInput"
                        android:inputType="textPassword"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/retype_password_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- FINALLY THE CTA ? ETA TA TA ? -->
                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/accentColor"
                    android:text="@string/sign_up_CTA" />


                <!-- Errors -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/signUpErrorText"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/errorColor"
                    android:visibility="gone"/>

                <!-- navigate to log in instead -->
                <TextView
                    style="@style/Text.Label"
                    android:id="@+id/LoginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accentColor"
                    android:text="@string/login_instead"
                    android:layout_marginTop="26dp"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="12dp"
                    android:layout_gravity="center"
                    />






            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>


</ScrollView>
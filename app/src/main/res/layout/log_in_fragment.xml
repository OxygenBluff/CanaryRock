<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/global_padding"
        >


        <TextView
            style="@style/Text.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_in_text"
            >
        </TextView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/global_padding"> <!-- -->

                <!-- 1-Email -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/email_label"/>

                <!-- The decoration THEN the actual textinput .. nested -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    >
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/loginEmailInput"
                        android:inputType="text"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/email_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2-Password  -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/password_label"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:endIconMinSize="@dimen/textfield_icon_size"
                    app:endIconTint="@color/black"

                    >
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/loginPasswordInput"
                        android:inputType="textPassword"
                        android:minHeight="0dp"

                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"

                        android:textColor="@color/black"
                        android:hint="@string/password_hint"
                        android:textColorHint="@color/text_hint"
                        />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/accentColor"
                    android:text="@string/log_in_CTA" />


                <!-- Errors -->
                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/loginErrorText"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/errorColor"
                    android:visibility="gone"/>

                <!-- navigate to SIGN UP in instead -->
                <TextView
                    style="@style/Text.Label"
                    android:id="@+id/SignupLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accentColor"
                    android:text="@string/signup_instead"
                    android:layout_marginTop="26dp"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="12dp"
                    android:layout_gravity="center"
                    />


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>


</ScrollView>